# BLUT Kubernetes operator image.
#
# Runs the reconcile loop that turns BlutPlan resources into Jobs and keeps
# BlutWorkerPool StatefulSets alive. This is the only image that carries
# kube-rs; the engine has no Kubernetes dependency.
#
#   docker build -f docker/Dockerfile.operator -t blut-operator:dev .
#
# The operator crate is a standalone workspace, so only its directory is
# copied. Rust 1.88 is the operator's MSRV and the engine's.

ARG RUST_IMAGE=rust:1.88-bookworm
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot

FROM ${RUST_IMAGE} AS builder
ARG CARGO_BUILD_JOBS=8
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} CARGO_TARGET_DIR=/target
WORKDIR /src
COPY crates/blut-operator/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/target,id=blut-operator-target \
    cargo build --release --locked --bin blut-operator \
 && install -D -m 0755 /target/release/blut-operator /out/blut-operator

FROM ${RUNTIME_IMAGE}
COPY --from=builder /out/blut-operator /usr/local/bin/blut-operator
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/blut-operator"]
CMD ["run"]
